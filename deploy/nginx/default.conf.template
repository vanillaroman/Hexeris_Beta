# nginx for Hexeris: TLS termination, reverse proxy to the app and WebSocket
# upgrades. ${DOMAIN} is substituted by the nginx image from the DOMAIN
# environment variable.
#
# Security headers (CSP, Referrer-Policy, Permissions-Policy, X-Frame-Options,
# X-Content-Type-Options) are set by the application itself and deliberately
# not duplicated here, which would produce conflicting policies.
#
# Engine-level settings such as worker_connections live in nginx.conf.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# A keepalive pool to the application. Without it every HTTP request —
# /history, /status, /reactions, /search, all of which a client issues on
# each reconnect — opens a new TCP connection: an extra handshake, an extra
# accept and a sediment of TIME_WAIT sockets at peak.
upstream hexeris_app {
    server app:8080;
    keepalive 128;
    keepalive_requests 10000;
    keepalive_timeout 60s;
}

# HTTP: the ACME challenge for certificates, plus a redirect to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# HTTPS: static files, API and WebSocket traffic all reach the application.
server {
    # backlog is the queue of unaccepted connections. The default of 511
    # overflows during a mass reconnect: a restart drops every client at
    # once and they all come back together.
    listen 443 ssl backlog=4096 reuseport;
    listen [::]:443 ssl backlog=4096 reuseport;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Session resumption. The default is off, so every reconnect — a mobile
    # network change, an unlocked phone, a server restart — costs a full
    # handshake with asymmetric cryptography. In a messenger, where
    # reconnects are routine, that is the single largest CPU cost at the
    # edge. A 10m cache holds roughly 40000 sessions.
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets on;

    # The 16k default makes nginx wait for a full TLS record before writing
    # to the socket. Chat messages are small frames that benefit from
    # leaving immediately rather than travelling in one large record.
    ssl_buffer_size 4k;

    # Slightly above the application's own 60 MB limit, so a 413 comes from
    # the app as readable text rather than from nginx as an HTML page.
    client_max_body_size 64m;
    client_body_buffer_size 256k;

    # ── WebSocket: its own location ──────────────────────────────────────
    # An upgraded connection is a tunnel and must never return to the
    # keepalive pool, so Connection is always $connection_upgrade here.
    location /ws {
        proxy_pass http://hexeris_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Secure WebSockets are long-lived, so no short timeout. The client
        # pings every 25 s and the server keeps a 90 s read deadline, so
        # genuinely silent connections do not occur and the hour here is
        # only a backstop.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Buffering a tunnel is pointless and only adds latency.
        proxy_buffering off;
        # TCP keepalive on the upstream socket, or a dead application is
        # only noticed when the hour-long timeout expires.
        proxy_socket_keepalive on;
    }

    # ── Everything else: static files and the JSON API, over keepalive ───
    location / {
        proxy_pass http://hexeris_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # An empty Connection header is required for upstream keepalive.
        proxy_set_header Connection "";

        # Ordinary requests must not hang for an hour: if the application
        # stalls, a 504 that lets the client retry beats accumulating
        # stuck connections.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_connect_timeout 5s;
    }
}
