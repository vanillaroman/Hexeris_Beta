# Hexeris — production configuration (docker-compose.prod.yml).
#   cp .env.example .env   and fill in the values below.
# Development (docker-compose.yml, localhost) needs no .env: its secrets are
# baked into the compose file. Never commit .env; generate secrets with the
# commands given in the comments.

# ── Domain ──────────────────────────────────────────────────────────────────
APP_DOMAIN=chat.example.com           # your domain (A record → this host's IP)
APP_NAME=Hexeris                      # product name shown in the UI

# ── Database (internal to the compose stack) ────────────────────────────────
POSTGRES_DB=hexeris
POSTGRES_USER=hexeris
POSTGRES_PASSWORD=                    # openssl rand -base64 24

# ── Application secrets (required) ──────────────────────────────────────────
JWT_SECRET=                           # openssl rand -base64 48
# ⚠ SERVER_ENC_KEY encrypts message bodies in the database AND files on disk.
#   A backup without this key is useless. Store it separately and never
#   rotate it on a live deployment.
SERVER_ENC_KEY=                       # openssl rand -base64 32   (exactly 32 bytes)

# ── Admin API (metrics and user management) ─────────────────────────────────
ADMIN_KEY=                            # openssl rand -base64 24 (sent as X-Admin-Key)
ADMIN_ALLOWED_IPS=                    # e.g. 203.0.113.7 (comma-separated); empty = no IP filter
ADMIN_ORIGIN=                         # origin of the admin panel, e.g. https://admin.example.com
TRUSTED_PROXY_IPS=                    # trusted proxy addresses for X-Forwarded-For

# ── TURN / WebRTC (calls) ───────────────────────────────────────────────────
TURN_SECRET=                          # openssl rand -base64 24 — must match static-auth-secret in deploy/coturn/turnserver.conf
# TURN_URLS may be left empty: the server derives turn/turns URLs from APP_DOMAIN.
TURN_URLS=

# ── Web Push (optional; without keys push is simply disabled) ───────────────
VAPID_PUBLIC_KEY=                     # generate a VAPID pair, see docs/operations/DEPLOY.md
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# ── Google sign-in (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Corporate single sign-on, OIDC (optional) ───────────────────────────────
# Works with Keycloak, Authentik, Entra ID, Okta and Google Workspace. Added as
# a second way in: passwords and LDAP keep working alongside it. Disabling an
# employee at the provider then removes their access here as well, which is the
# usual reason a security team asks for this. Full guide:
# docs/engineering/SSO-OIDC.md
#OIDC_ENABLED=true
#OIDC_ISSUER=https://sso.example.com/realms/hexeris
#OIDC_CLIENT_ID=hexeris
#OIDC_CLIENT_SECRET=
# Must match what the provider has on record CHARACTER FOR CHARACTER — a
# mismatch is the most common cause of refusal, and providers report it badly.
#OIDC_REDIRECT_URL=https://chat.example.com/auth/oidc/callback
#OIDC_SCOPES=openid email profile
#OIDC_USERNAME_CLAIM=email
#OIDC_BUTTON_LABEL=Sign in with SSO

# ── Two-factor authentication (TOTP) ────────────────────────────────────────
# Needs nothing here: each employee enables it themselves from the settings
# menu. This only changes how the account is labelled in the authenticator app;
# it defaults to APP_DOMAIN, which is what tells two instances apart in a list.
#TOTP_ISSUER=

# ── Registration and onboarding ─────────────────────────────────────────────
# Public self-registration is disabled by default: a stranger who finds the
# URL must not be able to create an account in a company chat. Enable it only
# for an open deployment. Existing users are unaffected.
REGISTRATION_ENABLED=false
# Allowlist of domains for Google sign-in and for accounts created through
# Google (a domain-wide invitation). Empty = no restriction.
ALLOWED_EMAIL_DOMAINS=                # e.g. acme.com,acme.io

# How many accounts may be created from one IP address per 10 minutes. Applies
# only when REGISTRATION_ENABLED=true. Three suits a corporate instance; on an
# internal stand behind shared NAT it is exhausted immediately.
REGISTER_MAX_PER_IP=3

# ── Backups of the database and files (disabled by default) ─────────────────
DB_BACKUP_ENABLED=false
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_KEEP=7
# Command that copies a fresh backup off this machine. It receives
# BACKUP_FILE, BACKUP_FILES_ARCHIVE and BACKUP_DIR in its environment.
# Example: rclone copy "$BACKUP_FILE" remote:hexeris-backups/
DB_BACKUP_OFFSITE_CMD=

# ── Retention (disabled by default) ─────────────────────────────────────────
RETENTION_ENABLED=false
RETENTION_MESSAGE_DAYS=365
RETENTION_AUDIT_DAYS=180
RETENTION_INTERVAL_HOURS=24
# The sign-in audit is pruned on its own schedule, regardless of the setting
# above: a username plus an IP address is personal data. 0 disables pruning.
LOGIN_AUDIT_KEEP_DAYS=90

# ── LDAP / Active Directory (optional; requires a build with -tags ldap) ────
# Employees then sign in with their directory credentials and local accounts
# are provisioned automatically on first sign-in.
#LDAP_URL=ldaps://dc.corp.example:636
# Either a direct bind template with %s …
#LDAP_USER_DN_TEMPLATE=%s@corp.example
# … or a service account that searches for the user:
#LDAP_BIND_DN=CN=svc-chat,OU=Service,DC=corp,DC=example
#LDAP_BIND_PASSWORD=
#LDAP_BASE_DN=DC=corp,DC=example
#LDAP_USER_FILTER=(sAMAccountName=%s)
#LDAP_START_TLS=false
#LDAP_SKIP_VERIFY=false

# ── Performance / Postgres ──────────────────────────────────────────────────
# The defaults suit a small host (~1 GB of RAM for the database). Raise them
# on a larger machine: shared_buffers ≈ 25% of RAM, effective_cache_size
# ≈ 50–75%. None of these cost durability.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_MAX_WAL_SIZE=2GB

# ⚠ The only setting here that has a price. `off` speeds up message writes
# (+10% on its own, +24% together with dropping the duplicate indexes) but
# loses the last ~200 ms of acknowledged messages if the operating system or
# hardware fails. An application crash is safe either way, and the client is
# idempotent by message id with its own outbound queue, so the practical risk
# is small — but this should be a deliberate choice. Full durability by default.
PG_SYNCHRONOUS_COMMIT=on

# Database connection pool size. Measured at 50 / 16 / 8 with 500 clients, the
# difference was within noise (16545 / 17107 / 15765 msg/s), because batched
# message writes took the pressure off the pool. On a 1 GB machine 16 is
# reasonable: every Postgres backend costs several megabytes.
DB_MAX_OPEN_CONNS=50

# WebSocket frame compression (permessage-deflate). Disabling it saved almost
# no memory in testing (32.8 vs 31.7 MiB across 500 connections, since the
# library pools its buffers) while compression does save mobile traffic, so it
# stays on.
WS_COMPRESSION=true

# ── Advanced database tuning (defaults are sensible; change deliberately) ───
# Ceiling on any single query, so a stuck one cannot hold a pool connection.
#DB_STATEMENT_TIMEOUT_MS=10000
# Connect timeout, which turns an unreachable database into a fast, honest 503.
#DB_CONNECT_TIMEOUT_S=3
# How long an idle pooled connection lives. Lower values recover faster after a
# database restart, at the cost of reconnecting more often.
#DB_CONN_MAX_IDLE_S=60

# ── TLS terminated by the application itself (not needed behind a proxy) ────
#TLS_MODE=tls
#TLS_CERT=/etc/letsencrypt/live/chat.example.com/fullchain.pem
#TLS_KEY=/etc/letsencrypt/live/chat.example.com/privkey.pem

# ── Debugging ───────────────────────────────────────────────────────────────
# One log line per delivered message (metadata only, never content). Off in
# production: it is a syscall under a global mutex on the hot path, and one
# load run produced 772000 lines.
DEBUG_MESSAGE_LOG=0
